generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
  previewFeatures = ["driverAdapters", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp", schema: "public")]
}

/// User model managed by NextAuth
/// Supports both CUSTOMER and MERCHANT roles
/// Extended for B2B procurement
model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  role               Role     @default(SHOPPER)
  name               String?
  // B2B fields
  employeeRole       EmployeeRole? @default(EMPLOYEE)
  department         String?
  departmentId       String?
  dept               Department? @relation(fields: [departmentId], references: [id])
  purchaseRequests   PurchaseRequest[]
  approvedOrders     Order[] @relation("OrderApprovals")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/// Shopping Cart (per-user, single active cart)
/// Uses JSONB for items to avoid N+1 queries on cart retrieval
model Cart {
  id          String     @id @default(cuid())
  customerId  String     @unique @map("customer_id")
  coupon_code String?
  version     Int        @default(1)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  cartItems   CartItem[]

  @@map("carts")
}

/// Commerce Event (events layer for proactive agent notifications)
/// Tracks events like cart abandonment, stock alerts, price drops
model CommerceEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_type  String
  userId      String?   @map("user_id")
  payload     Json
  processed   Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  @@index([userId, createdAt], map: "idx_commerce_events_user")
  @@map("commerce_events")
}

/// Product embedding for semantic search (legacy, kept for migration)
model ProductEmbedding {
  id             String                @id @default(uuid())
  productId      Int                   @map("product_id")
  embedding      Unsupported("vector") @map("embedding")
  embeddingModel String                @default("nomic-embed-text") @map("embedding_model")
  createdAt      DateTime              @default(now()) @map("created_at")
  Product        Product               @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("product_embeddings")
}

/// Document chunks for RAG (kept for existing functionality)
model Document {
  id        String          @id @default(uuid())
  title     String
  content   String
  docType   String          @map("doc_type")
  category  String?
  metadata  Json?           @default("{}")
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  chunks    DocumentChunk[]

  @@map("documents")
}

/// Document chunks for granular retrieval
model DocumentChunk {
  id         String                @id @default(uuid())
  documentId String                @map("document_id")
  content    String
  chunkIndex Int                   @map("chunk_index")
  embedding  Unsupported("vector") @map("embedding")
  tokenCount Int?                  @map("token_count")
  metadata   Json?                 @default("{}")
  createdAt  DateTime?             @default(now()) @map("created_at")
  document   Document              @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@map("document_chunks")
}

/// Webhook event tracking for idempotency
model WebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique @map("event_id")
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")
  data        Json?    @default("{}")

  @@index([eventId])
  @@index([eventType])
  @@map("webhook_events")
}

/// Customer profile - separate from User for billing/shipping info
model Customer {
  id             Int             @id @default(autoincrement())
  name           String?
  email          String          @unique
  phone          String?
  address        String?
  paymentMethod  String?
  billingAddress String?
  createdAt      DateTime        @default(now())
  Order          Order[]
  SupportTicket  SupportTicket[]

  @@map("Customer")
}

/// Support ticket for customer service
model SupportTicket {
  id             Int      @id @default(autoincrement())
  customerId     Int
  issue          String
  status         String
  createdAt      DateTime @default(now())
  priority       String?
  relatedOrderId Int?
  resolution     String?
  Customer       Customer @relation(fields: [customerId], references: [id])

  @@map("SupportTicket")
}

/// Cart item - line items in a cart
model CartItem {
  id        String  @id @default(uuid())
  cartId    String  @map("cart_id")
  productId Int     @map("product_id")
  quantity  Int     @default(1)
  price     Float
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@map("cart_items")
}

/// Promotional coupon
model Coupon {
  id             Int       @id @default(autoincrement())
  code           String    @unique
  discountType   String    @map("discount_type")
  discountValue  Float     @map("discount_value")
  minOrderAmount Float?    @map("min_order_amount")
  expiresAt      DateTime? @map("expires_at")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("coupons")
}

/// Stripe refund record
model Refund {
  id              Int      @id @default(autoincrement())
  stripeRefundId  String   @unique @map("stripe_refund_id")
  paymentIntentId String   @map("payment_intent_id")
  orderId         Int?     @map("order_id")
  customerEmail   String?  @map("customer_email")
  amount          Int
  currency        String   @default("usd")
  status          String
  reason          String?
  idempotencyKey  String?  @map("idempotency_key")
  metadata        Json?    @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  order           Order?   @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([paymentIntentId])
  @@index([status])
  @@map("refunds")
}

/// Agent notification for proactive messaging
model AgentNotification {
  id         String    @id @default(uuid())
  customerId String    @map("customer_id")
  type       String
  payload    String
  read       Boolean   @default(false)
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([customerId, read])
  @@map("agent_notifications")
}

/// Order refund status tracking
model OrderRefund {
  id           Int      @id @default(autoincrement())
  orderId      Int      @unique @map("order_id")
  refundStatus String   @default("none") @map("refund_status")
  refundAmount Int      @default(0) @map("refund_amount")
  lastRefundId String?  @map("last_refund_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  order        Order    @relation(fields: [orderId], references: [id])

  @@map("order_refunds")
}

model Order {
  id              Int          @id @default(autoincrement())
  customerId      Int
  productId       Int
  orderDate       DateTime     @default(now())
  total           Float
  status          String
  quantity        Int          @default(1)
  paymentStatus   String?
  shippingAddress String?
  trackingNumber  String?
  // B2B fields
  prId            String?      @unique
  pr              PurchaseRequest? @relation(fields: [prId], references: [id])
  approvedById    String?
  approvedBy      User?        @relation("OrderApprovals", fields: [approvedById], references: [id])
  Customer        Customer     @relation(fields: [customerId], references: [id])
  Product         Product      @relation(fields: [productId], references: [id])
  orderRefund     OrderRefund?
  refunds         Refund[]
}

model Product {
  id                 Int                      @id @default(autoincrement())
  name               String
  description        String?
  price              Float
  stock              Int
  image              String?
  category           String?
  sku                String?
  brand              String?
  rating             Float?
  version            Int                     @default(1)
  search_vector      Unsupported("tsvector")?
  embedding          Unsupported("vector")?
  Order              Order[]
  cartItems          CartItem[]
  product_embeddings ProductEmbedding[]

  @@index([search_vector], map: "product_search_idx", type: Gin)
}

model user_embeddings {
  id           String                @id
  user_id      String
  embedding    Unsupported("vector")
  query_text   String
  context_type String
  context_id   String?
  metadata     Json?                 @default("{}")
  created_at   DateTime              @default(now())
  updated_at   DateTime

  @@unique([user_id, query_text, context_type, context_id])
}

/// Department for B2B procurement
model Department {
  id             String   @id @default(cuid())
  name           String   @unique   // "Engineering"
  code           String   @unique   // "ENG"
  monthlyBudget  Int      @default(0)  // paise / cents
  spentThisMonth Int      @default(0)
  approverEmail  String   // Single approver per PRD

  employees      User[]
  purchaseRequests PurchaseRequest[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Purchase Request
model PurchaseRequest {
  id            String   @id @default(cuid())
  prNumber      String   @unique  // "PR-2026-0001"
  status        PRStatus @default(DRAFT)
  totalAmount   Int      @default(0)  // paise / cents
  justification String
  urgency       PRUrgency @default(NORMAL)
  notes         String?  // approver notes

  requestorId   String
  requestor     User       @relation(fields: [requestorId], references: [id])
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id])

  lineItems     PRLineItem[]
  approvals     PRApproval[]
  auditEntries  PRAuditEntry[]
  order         Order?       // set after PO raised

  submittedAt   DateTime?
  approvedAt    DateTime?
  rejectedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// PR Line Item
model PRLineItem {
  id             String  @id @default(cuid())
  quantity       Int
  unitPrice      Int     // paise / cents at time of request
  totalPrice     Int     // line total before tax
  
  // Tax/GST fields (PRD Part 5 - Feature 2)
  taxRate        Int      @default(18)  // GST rate in percent
  taxAmount     Int      @default(0)  // calculated: line_total * tax_rate / 100
  totalWithTax  Int      @default(0)  // calculated: line_total + tax_amount

  prId           String
  pr             PurchaseRequest @relation(fields: [prId], references: [id], onDelete: Cascade)
  catalogItemId  String
  catalogItem    CatalogItem @relation(fields: [catalogItemId], references: [id])

  @@unique([prId, catalogItemId])
}

/// Catalog Item (replaces Product for B2B context)
model CatalogItem {
  id              String   @id @default(cuid())
  name            String
  description     String
  sku             String   @unique
  unitPrice       Int      // paise / cents
  category        CatalogCategory
  vendor          String
  vendorCode      String
  leadDays        Int      @default(3)
  inStock         Boolean  @default(true)
  minOrderQty     Int      @default(1)
  imageUrl        String?
  vendorApproved  Boolean  @default(true)  // B2B: approved vendor list
  msaExpiryDate   DateTime?               // B2B: MSA validity check
  vendorRating    Int?                    // B2B: vendor performance (1-5)
  searchVector  String?   // Full-text search: name + description + sku + vendor

  lineItems     PRLineItem[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([searchVector])
}

/// PR Approval
model PRApproval {
  id             String         @id @default(cuid())
  status         ApprovalStatus @default(PENDING)
  approverEmail  String
  approverName   String?
  comments       String?
  decidedAt      DateTime?

  prId           String
  pr             PurchaseRequest @relation(fields: [prId], references: [id])

  createdAt      DateTime @default(now())
}

/// PR Audit Entry (immutable append-only audit trail)
model PRAuditEntry {
  id        String   @id @default(cuid())
  action    String   // "PR_CREATED" | "SUBMITTED" | "APPROVED" | ...
  actor     String   // email or "SYSTEM"
  details   Json     @default("{}")
  prId      String
  pr        PurchaseRequest @relation(fields: [prId], references: [id])
  createdAt DateTime @default(now())
}

/// User roles for RBAC
enum Role {
  SHOPPER
  MERCHANT
  SUPPORT
  ADMIN
}

/// Employee roles for B2B procurement
enum EmployeeRole {
  EMPLOYEE   // can create PRs
  MANAGER    // can approve/reject PRs
  FINANCE    // read-only; sees all PRs + budget
  ADMIN      // full access (replaces old ADMIN)
}

/// Purchase Request status
enum PRStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ORDERED       // PO raised, vendor notified
  RECEIVED      // goods/services confirmed
  DISPUTED
  CANCELLED
}

/// Purchase Request urgency
enum PRUrgency {
  LOW
  NORMAL
  HIGH
  CRITICAL     // bypasses standard 48h SLA
}

/// Approval status
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  DELEGATED
}

/// Catalog item category
enum CatalogCategory {
  HARDWARE
  SOFTWARE
  SERVICES
  OFFICE_SUPPLIES
  INFRASTRUCTURE
  OTHER
}
