generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// User embedding for preference history and semantic search
/// Stores 384-dimensional vectors generated from user queries
model UserEmbedding {
  id          String                @id @default(uuid())
  userId      String                @map("user_id")
  embedding   Unsupported("vector") @map("embedding")
  queryText   String                @map("query_text")
  contextType String                @map("context_type")
  contextId   String?               @map("context_id")
  metadata    Json?                 @default("{}")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  @@unique([userId, queryText, contextType, contextId])
  @@map("user_embeddings")
}

model Customer {
  id             Int             @id @default(autoincrement())
  name           String?
  email          String          @unique
  phone          String?
  address        String?
  paymentMethod  String?
  billingAddress String?
  createdAt      DateTime        @default(now())
  orders         Order[]
  supportTickets SupportTicket[]
}

model Product {
  id          Int                @id @default(autoincrement())
  name        String
  description String?
  price       Float
  stock       Int
  image       String?
  category    String?
  sku         String?
  brand       String?
  rating      Float?

  // Full-text search vector (tsvector) for keyword matching
  // Populated via trigger on insert/update
  searchVector Unsupported("tsvector")? @map("search_vector")

  // Semantic embedding for vector similarity (384-dim for sentence-transformers)
  embedding    Unsupported("vector(384)")? @map("embedding")

  orders       Order[]
  embeddings   ProductEmbedding[]
  cartItems    CartItem[]  // Opposite relation for CartItem

  @@index([searchVector], type: Gin, name: "product_search_idx")
  // HNSW index will be created via raw SQL migration (Prisma doesn't support HNSW)
}

model Order {
  id              Int          @id @default(autoincrement())
  customerId      Int
  productId       Int
  orderDate       DateTime     @default(now())
  total           Float
  status          String
  quantity        Int          @default(1)
  paymentStatus   String?
  shippingAddress String?
  trackingNumber  String?
  customer        Customer     @relation(fields: [customerId], references: [id])
  product         Product      @relation(fields: [productId], references: [id])
  orderRefund     OrderRefund?
  refunds         Refund[]
}

model SupportTicket {
  id             Int      @id @default(autoincrement())
  customerId     Int
  issue          String
  status         String
  createdAt      DateTime @default(now())
  priority       String?
  relatedOrderId Int?
  resolution     String?
  customer       Customer @relation(fields: [customerId], references: [id])
}

/// Refund record for tracking Stripe refunds
model Refund {
  id              Int      @id @default(autoincrement())
  stripeRefundId  String   @unique @map("stripe_refund_id")
  paymentIntentId String   @map("payment_intent_id")
  orderId         Int?     @map("order_id")
  customerEmail   String?  @map("customer_email")
  amount          Int
  currency        String   @default("usd")
  status          String
  reason          String?
  idempotencyKey  String?  @map("idempotency_key")
  metadata        Json?    @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  order           Order?   @relation(fields: [orderId], references: [id])

  @@index([paymentIntentId])
  @@index([orderId])
  @@index([status])
  @@map("refunds")
}

/// Webhook event tracking for idempotency
model WebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique @map("event_id")
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")
  data        Json?    @default("{}")

  @@index([eventId])
  @@index([eventType])
  @@map("webhook_events")
}

/// Order refund status tracking
model OrderRefund {
  id             Int      @id @default(autoincrement())
  orderId        Int      @unique @map("order_id")
  refundStatus   String   @default("none") @map("refund_status")
  refundedAmount Int      @default(0) @map("refund_amount")
  lastRefundId   String?  @map("last_refund_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  order          Order    @relation(fields: [orderId], references: [id])

  @@map("order_refunds")
}

/// Shopping Cart
model Cart {
  id          String     @id @default(uuid())
  customerId  String    @map("customer_id")
  items       CartItem[]
  couponCode  String?   @map("coupon_code")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  @@unique([customerId])
  @@map("carts")
}

/// Cart Item
model CartItem {
  id         String   @id @default(uuid())
  cartId     String   @map("cart_id")
  productId  Int      @map("product_id")
  quantity   Int      @default(1)
  price      Float    // Price at time of adding to cart
  product    Product  @relation(fields: [productId], references: [id])
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  
  @@unique([cartId, productId])
  @@map("cart_items")
}

/// Coupon/Promo code
model Coupon {
  id              Int       @id @default(autoincrement())
  code            String    @unique
  discountType    String    @map("discount_type") // 'percentage' | 'fixed'
  discountValue   Float     @map("discount_value")
  minOrderAmount  Float?    @map("min_order_amount")
  expiresAt       DateTime? @map("expires_at")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  
  @@map("coupons")
}

/// Product knowledge embeddings for semantic search
/// Uses 768-dimensional vectors from nomic-embed-text
model ProductEmbedding {
  id             String                @id @default(uuid())
  productId      Int                   @map("product_id")
  embedding      Unsupported("vector") @map("embedding")
  embeddingModel String                @default("nomic-embed-text") @map("embedding_model")
  createdAt      DateTime              @default(now()) @map("created_at")
  product        Product               @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("product_embeddings")
}

/// Knowledge base document for RAG
model Document {
  id        String          @id @default(uuid())
  title     String
  content   String
  docType   String          @map("doc_type")
  category  String?
  metadata  Json?           @default("{}")
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  chunks    DocumentChunk[]

  @@map("documents")
}

/// Document chunks for granular retrieval
model DocumentChunk {
  id         String                @id @default(uuid())
  documentId String                @map("document_id")
  content    String
  chunkIndex Int                   @map("chunk_index")
  embedding  Unsupported("vector") @map("embedding")
  tokenCount Int?                  @map("token_count")
  metadata   Json?                 @default("{}")
  createdAt  DateTime?             @default(now()) @map("created_at")
  document   Document              @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@map("document_chunks")
}
enum Role {
  SHOPPER
  MERCHANT
  SUPPORT
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(SHOPPER)
  name         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}
