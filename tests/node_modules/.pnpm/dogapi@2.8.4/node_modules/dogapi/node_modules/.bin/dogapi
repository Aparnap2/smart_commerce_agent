#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/aparna/Desktop/vercel-ai-sdk/tests/node_modules/.pnpm/dogapi@2.8.4/node_modules/dogapi/bin/node_modules:/home/aparna/Desktop/vercel-ai-sdk/tests/node_modules/.pnpm/dogapi@2.8.4/node_modules/dogapi/node_modules:/home/aparna/Desktop/vercel-ai-sdk/tests/node_modules/.pnpm/dogapi@2.8.4/node_modules:/home/aparna/Desktop/vercel-ai-sdk/tests/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/aparna/Desktop/vercel-ai-sdk/tests/node_modules/.pnpm/dogapi@2.8.4/node_modules/dogapi/bin/node_modules:/home/aparna/Desktop/vercel-ai-sdk/tests/node_modules/.pnpm/dogapi@2.8.4/node_modules/dogapi/node_modules:/home/aparna/Desktop/vercel-ai-sdk/tests/node_modules/.pnpm/dogapi@2.8.4/node_modules:/home/aparna/Desktop/vercel-ai-sdk/tests/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../bin/dogapi" "$@"
else
  exec node  "$basedir/../../bin/dogapi" "$@"
fi
