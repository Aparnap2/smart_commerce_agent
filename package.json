{
  "name": "smart-commerce-agent",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "test": "turbo test",
    "build": "turbo build",
    "db:migrate": "pnpm --filter @smart-commerce/web prisma migrate dev",
    "db:generate": "pnpm --filter @smart-commerce/web prisma generate",
    "db:seed": "pnpm --filter @smart-commerce/web prisma db seed"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "yaml": "^2.8.2"
  }
}